datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleEnum {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  TERMINATED
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
  PROBATION
  FREELANCE
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  LATE_AND_EARLY_LEAVE
  ABSENT
  ON_LEAVE
}

enum AttendanceMethod {
  WEB
  MOBILE
  BIOMETRIC
}

enum StatusWorkflow {
  DRAFT
  CALCULATED
  REVIEW
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum DeviceStatus {
  PENDING
  APPROVED
  BLOCKED
}

model Role {
  id          String           @id @default(uuid())
  name        RoleEnum         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  module      String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  roleId                String
  role                  Role                   @relation(fields: [roleId], references: [id])
  employeeId            String?                @unique
  employee              Employee?              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  isActive              Boolean                @default(true)
  refreshToken          String?
  notifications         Notification[]
  auditLogs             AuditLog[]
  attendanceAdjustments AttendanceAdjustment[] @relation("AdjustedBy")
  approvedOvertimes     OvertimeRecord[]       @relation("OvertimeApprover")
  approvedLeaves        LeaveRequest[]         @relation("LeaveApprover")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("users")
}

model Department {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String?
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  managerId   String?
  manager     Employee?    @relation("DepartmentManager", fields: [managerId], references: [id])
  employees   Employee[]   @relation("EmployeeDepartment")
  positions   Position[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("departments")
}

model Position {
  id            String      @id @default(uuid())
  code          String      @unique
  title         String
  description   String?
  baseSalaryMin Float       @default(0)
  baseSalaryMax Float       @default(0)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  employees     Employee[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("positions")
}

model Employee {
  id                 String                 @id @default(uuid())
  employeeCode       String                 @unique
  firstName          String
  lastName           String
  email              String                 @unique
  phone              String?
  gender             String?
  dob                DateTime?
  address            String?
  nationalId         String?                @unique
  taxId              String?
  bankAccount        String?
  bankName           String?
  departmentId       String?
  department         Department?            @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  positionId         String?
  position           Position?              @relation(fields: [positionId], references: [id])
  managerId          String?
  manager            Employee?              @relation("EmployeeManagerRelation", fields: [managerId], references: [id])
  subordinates       Employee[]             @relation("EmployeeManagerRelation")
  managedDepartments Department[]           @relation("DepartmentManager")
  hireDate           DateTime               @default(now())
  status             EmploymentStatus       @default(ACTIVE)
  user               User?
  profile            EmployeeProfile?
  documents          EmployeeDocument[]
  contracts          Contract[]
  shiftAssignments   ShiftAssignment[]
  workSchedules      WorkSchedule[]
  attendances        AttendanceRecord[]
  attendanceAdjust   AttendanceAdjustment[] @relation("EmployeeAttendanceAdjust")
  overtimeRecords    OvertimeRecord[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  salaryStructure    SalaryStructure?
  bonuses            Bonus[]
  payrolls           Payroll[]
  workDays           WorkDay[]
  registeredDevices  RegisteredDevice[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@map("employees")
}

model EmployeeProfile {
  id                    String   @id @default(uuid())
  employeeId            String   @unique
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bio                   String?
  avatar                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  maritalStatus         String?
  education             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("employee_profiles")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  documentType String
  fileUrl      String
  uploadedAt   DateTime @default(now())

  @@map("employee_documents")
}

model Contract {
  id             String       @id @default(uuid())
  contractNumber String       @unique
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType   ContractType @default(FIXED_TERM)
  startDate      DateTime
  endDate        DateTime?
  salary         Float
  status         String       @default("ACTIVE")
  documentUrl    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("contracts")
}

model WorkShift {
  id                      String            @id @default(uuid())
  code                    String            @unique
  name                    String
  startTime               String // "08:00"
  endTime                 String // "17:00"
  breakStartTime          String? // "12:00"
  breakEndTime            String? // "13:00"
  lateToleranceMins       Int               @default(15)
  earlyLeaveToleranceMins Int               @default(15)
  isOvernight             Boolean           @default(false)
  shiftAssignments        ShiftAssignment[]
  workSchedules           WorkSchedule[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@map("work_shifts")
}

model ShiftAssignment {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      WorkShift @relation(fields: [shiftId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("shift_assignments")
}

model WorkSchedule {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  shiftId    String
  shift      WorkShift @relation(fields: [shiftId], references: [id])
  isHoliday  Boolean   @default(false)
  isRestDay  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
  @@map("work_schedules")
}

model AttendanceRecord {
  id            String                 @id @default(uuid())
  employeeId    String
  employee      Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime               @db.Date
  checkInTime   DateTime?
  checkOutTime  DateTime?
  ipAddress     String
  networkId     String?
  networkName   String?
  deviceId      String?
  deviceName    String?
  method        AttendanceMethod       @default(WEB)
  status        AttendanceStatus       @default(PRESENT)
  workingHours  Float                  @default(0)
  overtimeHours Float                  @default(0)
  remarks       String?
  adjustments   AttendanceAdjustment[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceAdjustment {
  id               String           @id @default(uuid())
  attendanceId     String
  attendance       AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee         @relation("EmployeeAttendanceAdjust", fields: [employeeId], references: [id], onDelete: Cascade)
  adjustedByUserId String
  adjustedByUser   User             @relation("AdjustedBy", fields: [adjustedByUserId], references: [id])
  originalCheckIn  DateTime?
  originalCheckOut DateTime?
  adjustedCheckIn  DateTime?
  adjustedCheckOut DateTime?
  reason           String
  status           StatusWorkflow   @default(APPROVED)
  auditNote        String?
  createdAt        DateTime         @default(now())

  @@map("attendance_adjustments")
}

model WorkDay {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  standardDays       Float    @default(22)
  actualWorkingDays  Float    @default(0)
  paidLeaveDays      Float    @default(0)
  unpaidLeaveDays    Float    @default(0)
  absenceDays        Float    @default(0)
  totalOvertimeHours Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@map("work_days")
}

model OvertimeRecord {
  id               String         @id @default(uuid())
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime       @db.Date
  startTime        String // "18:00"
  endTime          String // "21:00"
  hours            Float
  rateMultiplier   Float          @default(1.5)
  reason           String
  status           StatusWorkflow @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?          @relation("OvertimeApprover", fields: [approvedByUserId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("overtime_records")
}

model LeaveType {
  id               String         @id @default(uuid())
  code             String         @unique
  name             String
  description      String?
  maxDaysPerYear   Float          @default(12)
  isPaid           Boolean        @default(true)
  requiresApproval Boolean        @default(true)
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  createdAt        DateTime       @default(now())

  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  allocatedDays Float     @default(12)
  usedDays      Float     @default(0)
  pendingDays   Float     @default(0)
  remainingDays Float     @default(12)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id               String         @id @default(uuid())
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String
  leaveType        LeaveType      @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime
  endDate          DateTime
  totalDays        Float
  reason           String
  status           StatusWorkflow @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?          @relation("LeaveApprover", fields: [approvedByUserId], references: [id])
  approvalComment  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("leave_requests")
}

model SalaryStructure {
  id            String            @id @default(uuid())
  employeeId    String            @unique
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Float
  effectiveDate DateTime          @default(now())
  components    SalaryComponent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("salary_structures")
}

model SalaryComponent {
  id              String          @id @default(uuid())
  structureId     String
  structure       SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentName   String
  type            String // "ALLOWANCE" | "DEDUCTION" | "BONUS"
  amount          Float
  isTaxable       Boolean         @default(true)
  isInsuranceable Boolean         @default(true)

  @@map("salary_components")
}

model Allowance {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  amount    Float
  isTaxable Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("allowances")
}

model Bonus {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  amount     Float
  reason     String
  createdAt  DateTime @default(now())

  @@map("bonuses")
}

model Deduction {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  amount       Float
  isPercentage Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("deductions")
}

model PayrollPeriod {
  id               String         @id @default(uuid())
  name             String // e.g., "August 2026 Payroll"
  startDate        DateTime
  endDate          DateTime
  totalWorkingDays Float          @default(22)
  status           StatusWorkflow @default(DRAFT)
  payrolls         Payroll[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("payroll_periods")
}

model Payroll {
  id          String         @id @default(uuid())
  periodId    String
  period      PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary  Float
  allowances  Float          @default(0)
  bonuses     Float          @default(0)
  overtimePay Float          @default(0)
  commission  Float          @default(0)
  totalGross  Float
  deductions  Float          @default(0)
  insurance   Float          @default(0)
  tax         Float          @default(0)
  netSalary   Float
  status      StatusWorkflow @default(DRAFT)
  paymentDate DateTime?
  items       PayrollItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([periodId, employeeId])
  @@map("payrolls")
}

model PayrollItem {
  id          String  @id @default(uuid())
  payrollId   String
  payroll     Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  title       String
  itemType    String // "EARNING" | "DEDUCTION" | "TAX" | "INSURANCE"
  amount      Float
  description String?

  @@map("payroll_items")
}

model TaxConfiguration {
  id                String   @id @default(uuid())
  bracketName       String
  minIncome         Float
  maxIncome         Float?
  taxRatePercentage Float
  fixedDeduction    Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tax_configurations")
}

model InsuranceConfiguration {
  id                     String   @id @default(uuid())
  insuranceType          String // "SOCIAL", "HEALTH", "UNEMPLOYMENT"
  employeeRatePercentage Float
  employerRatePercentage Float
  maxSalaryCap           Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("insurance_configurations")
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(true)

  @@map("holidays")
}

model AttendanceNetwork {
  id          String   @id @default(uuid())
  name        String
  cidr        String   @unique // e.g. "192.168.10.0/24"
  location    String
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("attendance_networks")
}

model RegisteredDevice {
  id                String       @id @default(uuid())
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  deviceName        String
  os                String?
  browser           String?
  status            DeviceStatus @default(PENDING)
  registeredAt      DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([employeeId, deviceFingerprint])
  @@map("registered_devices")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // "LEAVE", "OVERTIME", "PAYROLL", "CONTRACT", "ATTENDANCE"
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model CompanySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("company_settings")
}
